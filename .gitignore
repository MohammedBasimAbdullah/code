from kivy.app import App
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.label import Label
from kivy.uix.button import Button
from kivy.uix.scrollview import ScrollView
from kivy.uix.textinput import TextInput
from kivy.uix.screenmanager import ScreenManager, Screen
from kivy.core.window import Window

Window.clearcolor = (0.1, 0.1, 0.1, 1)

class CaesarScreen(Screen):
    def __init__(self, **kwargs):
        super(CaesarScreen, self).__init__(**kwargs)
        layout = BoxLayout(orientation='vertical', padding=20, spacing=20)

        self.title = Label(text='Decryption Caesar Cipher', font_size=28, color=(0.6, 0.9, 1, 1), size_hint_y=None, height=50)
        self.instruction = Label(text='Enter the ciphertext below. It will be decrypted using all possible keys.',
                                 font_size=16, color=(1, 1, 1, 1), size_hint_y=None, height=40)

        self.input_text = TextInput(hint_text='Type the encrypted text here...',
                                    multiline=True, size_hint_y=0.3, background_color=(1, 1, 1, 0.1),
                                    foreground_color=(1, 1, 1, 1), cursor_color=(1, 1, 1, 1), padding=10)

        decode_button = Button(text='Decrypt Now',
                               background_color=(0.2, 0.6, 1, 1), font_size=20, size_hint_y=None, height=50)
        decode_button.bind(on_press=self.decode)

        self.result_label = Label(size_hint_y=None, text_size=(Window.width - 40, None),
                                  halign='right', valign='top', font_size=16, color=(1, 1, 1, 1))
        self.result_label.bind(texture_size=self.resize_label)

        scroll = ScrollView(size_hint=(1, 1))
        scroll.add_widget(self.result_label)

        layout.add_widget(self.title)
        layout.add_widget(self.instruction)
        layout.add_widget(self.input_text)
        layout.add_widget(decode_button)
        layout.add_widget(scroll)

        self.add_widget(layout)

    def resize_label(self, instance, size):
        self.result_label.height = size[1]

    def decode(self, instance):
        ciphertext = self.input_text.text
        results = ''
        for key in range(1, 26):
            decrypted = ''
            for char in ciphertext:
                if char.isalpha():
                    base = ord('A') if char.isupper() else ord('a')
                    decrypted += chr((ord(char) - base - key) % 26 + base)
                else:
                    decrypted += char
            results += f'[key{key}]  {decrypted}\n\n'
        self.result_label.text = results


class CaesarDecoderApp(App):
    def build(self):
        sm = ScreenManager()
        sm.add_widget(CaesarScreen(name='main'))
        return sm


if __name__ == '__main__':
    CaesarDecoderApp().run()
